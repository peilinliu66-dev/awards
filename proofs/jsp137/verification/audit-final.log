'Nondividing.External.convex_density_set' depends on axioms: [propext, Classical.choice, Quot.sound]
'Nondividing.External.blaschke_selection' depends on axioms: [propext, Classical.choice, Quot.sound]
'Nondividing.External.convexBody_volume_tendsto' depends on axioms: [propext, Classical.choice, Quot.sound]
'Nondividing.External.rogers_shephard' depends on axioms: [propext, Classical.choice, Quot.sound]
'Nondividing.External.full_rank_lattice_points_le_volume' depends on axioms: [propext, Classical.choice, Quot.sound]
'Nondividing.main_log_limit' depends on axioms: [propext, Classical.choice, Quot.sound]
'Erdos131Research.OriginalStatement.original_growth' depends on axioms: [propext, Classical.choice, Quot.sound]
